{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "ENGLISH WORDS", "size": "Small", "weight": "Bolder", "color": "Accent", "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            { "type": "TextBlock", "text": "${progress}", "size": "Small", "weight": "Bolder", "isSubtle": true, "spacing": "None" }
          ]
        }
      ]
    },
    { "type": "TextBlock", "text": "${status}", "size": "Small", "weight": "Bolder", "color": "Good", "spacing": "Small", "wrap": true },
    { "type": "TextBlock", "text": "${word}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "Small", "wrap": true },
    { "type": "TextBlock", "text": "${ipa}", "size": "Small", "isSubtle": true, "spacing": "None", "wrap": true },
    { "type": "TextBlock", "text": "${translation}", "spacing": "Small", "wrap": true }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "Open", "verb": "open-primary" },
    { "type": "Action.Execute", "title": "Review", "verb": "open-review" }
  ]
}
