# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.
# Only the project URL and the anon/publishable key belong here. They are public by design
# and protected by Row Level Security. NEVER put the service_role/secret key or the
# database password in this file — the build refuses to ship them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
